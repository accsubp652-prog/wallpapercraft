generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  isPremium Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación: Un usuario puede publicar varios fondos
  wallpapers Wallpaper[]

  @@map("User")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación: Una categoría contiene varios fondos
  wallpapers Wallpaper[]

  @@map("Category")
}

model Wallpaper {
  id           String   @id @default(uuid())
  title        String
  description  String?
  imageUrl     String
  thumbnailUrl String?
  resolution   String   @default("4K")
  isExclusive  Boolean  @default(false)
  price        Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relación con el usuario (Autor)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Relación opcional con la Categoría
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("Wallpaper")
}